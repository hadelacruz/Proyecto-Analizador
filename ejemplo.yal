(* ejemplo.yal — simple arithmetic lexer *)

let digit  = ['0'-'9']
let letter = ['a'-'z''A'-'Z''_']
let alphanum = {letter} | {digit}

rule gettoken =
  letter (alphanum)*         { return ID }
| digit digit*               { return NUMBER }
| '+'                        { return PLUS }
| '-'                        { return MINUS }
| '*'                        { return TIMES }
| '/'                        { return DIV }
| '('                        { return LPAREN }
| ')'                        { return RPAREN }
| ')'                        { return RPAREN }
| '='                        { return ASIGN }
